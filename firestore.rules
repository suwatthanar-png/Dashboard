rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 8
        && id.size() <= 64
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidScore(val) {
      return val is int && val >= 1 && val <= 5;
    }

    function isValidSurveyResponse(data, docId) {
      return data.keys().hasAll([
          'deviceId',
          'surveyKey',
          'q1',
          'q2',
          'q3',
          'q4',
          'q5',
          'comment',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'deviceId',
          'surveyKey',
          'q1',
          'q2',
          'q3',
          'q4',
          'q5',
          'comment',
          'createdAt'
        ])
        && isValidId(data.deviceId)
        && data.deviceId == docId
        && data.surveyKey is string
        && data.surveyKey.size() >= 3
        && data.surveyKey.size() <= 64
        && data.surveyKey == 'default-training'
        && isValidScore(data.q1)
        && isValidScore(data.q2)
        && isValidScore(data.q3)
        && isValidScore(data.q4)
        && isValidScore(data.q5)
        && data.comment is string
        && data.comment.size() <= 500
        && data.createdAt == request.time;
    }

    match /responses/{deviceId} {
      // Single-doc check to verify whether this device already submitted (no PII stored)
      allow get: if isValidId(deviceId);

      // Scoped public dashboard read for anonymous training aggregates & feedback
      allow list: if resource.data.surveyKey == 'default-training';

      // Create once per deviceId; immutable afterwards (no overwrite or deletion)
      allow create: if isValidId(deviceId)
        && isValidSurveyResponse(incoming(), deviceId);

      allow update: if false;
      allow delete: if false;
    }
  }
}
